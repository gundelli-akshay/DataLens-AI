# =================================================================
# DataLens AI — .gitignore
# =================================================================

# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# ─── Virtual Environments ─────────────────────────────────────
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/

# ─── Environment / Secrets ────────────────────────────────────
# Rule: NEVER commit real secrets. .env.example is safe to commit.
.env
*.env
!.env.example

# ─── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.cache/
*.local

# ─── Uploaded User Files ──────────────────────────────────────
# Keep the uploads directory itself tracked via .gitkeep
data/uploads/*
!data/uploads/.gitkeep

# ─── AI / Vector Store Artifacts ─────────────────────────────
faiss_index/
chroma_db/
*.index
*.pkl

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/
pip-log.txt

# ─── Testing & Coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath

# ─── Build / Distribution ─────────────────────────────────────
*.pyc
*.pyo
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Database ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
