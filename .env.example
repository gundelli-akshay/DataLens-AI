# ==============================================================================
# DataLens AI — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' for local work
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. File Uploads & Persistent Storage
# ------------------------------------------------------------------------------
# Directory path where uploaded CSV, XLSX, PDF, and DOCX documents are saved.
# In Docker/production, mount a persistent volume to this path.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///./datalens.db

# Production (PostgreSQL):
# Standard PostgreSQL URL (e.g. Supabase, Neon, AWS RDS, Render Postgres):
# DATABASE_URL=postgresql://postgres:your-strong-password@db.example.com:5432/datalens_db

# ------------------------------------------------------------------------------
# 4. AI / LLM (Groq Cloud)
# ------------------------------------------------------------------------------
# Your Groq API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 5. Authentication & Security
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret Key: Use a secure random string (minimum 32 characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=datalens-dev-super-secret-jwt-key-32-chars-minimum!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for API requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 7. Frontend Build Variables (optional, for standalone Vite build)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://api.yourdomain.com
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
