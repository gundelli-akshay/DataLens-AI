# ==============================================================================
# DataLens AI - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' for local work
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. File Uploads & Persistent Storage
# ------------------------------------------------------------------------------
# Directory path where temporary local cached copies of documents are stored for analysis
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# 2B. Persistent Object Storage (Supabase Storage)
# ------------------------------------------------------------------------------
# MANDATORY: Supabase Storage is the exclusive file storage backend for DataLens AI.
# Uploaded files are stored in object storage, not container ephemeral disk.
# Obtain these from: Supabase Dashboard -> Project Settings -> API & Storage.
# CRITICAL SECURITY: SUPABASE_KEY must remain backend-only. Never expose to clients!
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=datalens-files
STORAGE_BACKEND=supabase

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
# MANDATORY: PostgreSQL is the exclusive database backend for DataLens AI.
# SQLite is not supported. DATABASE_URL must be explicitly configured.
# Standard PostgreSQL URL (e.g. Supabase, Neon, AWS RDS, Render Postgres):
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/[database]

# ------------------------------------------------------------------------------
# 4. AI / LLM (Primary: Gemini 3.8 Flash, Secondary/Fallback: Groq)
# ------------------------------------------------------------------------------
# Primary: Google Gemini API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Secondary / Fallback: Groq API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 5. Authentication & Security
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Leave blank until ready to enable Google Sign-In
# When ready: Create in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID (Web application)
# Set Authorized JavaScript origins: http://localhost:5173, http://localhost:3000
GOOGLE_CLIENT_ID=

# JWT Secret Key: MANDATORY high-entropy random string (minimum 32 characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=datalens-dev-super-secret-jwt-key-32-chars-minimum!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, specify your exact frontend domain (e.g. https://datalens.yourdomain.com).
# Note: Wildcard '*' is strictly forbidden in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
